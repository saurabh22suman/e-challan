# Values for the Dokploy Environment editor. Copy the values into the Dokploy
# UI; do not commit a filled copy. Passwords must be URL-safe because
# POSTGRES_PASSWORD is embedded in DATABASE_URL. Avoid @ : / ? # and $.

POSTGRES_USER=echallan
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=echallan_demo
API_ORIGIN=http://api:3001

# Set true on the first deploy to load the realistic deployment fixture
# (locations, posts, shifts, staff, drivers, gate passes and challans) and assign
# the env Marshal / Supervisor to a demo location when they have none. Requires
# POSTGRES_DB=echallan_demo. Safe to leave true; the seed is insert-if-absent.
SEED_DEMO_DATA=false

# The one public HTTPS origin. Dokploy routes it to the admin service; the
# tablet is served internally at /tablet/ and needs no second domain.
PUBLIC_APP_ORIGIN=https://e-challan.thedutchrabbit.com

# Admin account used on the single public sign-in page. The example values
# below are the realistic fixture profiles (Meera Shah, Ravi Patel, Sunil
# Deshmukh). Custom usernames also work; the demo seed assigns a location to a
# custom Marshal/Supervisor. On first start the API creates a matching users row
# with no stored password, so this environment password is used at sign-in.
DEMO_ADMIN_USERNAME=EMP-1042
DEMO_ADMIN_PASSWORD=replace-with-a-long-admin-password

# The API requires all three role accounts to be configured. These rows are
# bootstrapped too; Marshal sign-in additionally needs an authorised post. A
# Marshal who signs in at the public origin is handed to /tablet/ automatically.
DEMO_MARSHAL_USERNAME=EMP-3106
DEMO_MARSHAL_PASSWORD=replace-with-a-long-marshal-password
DEMO_SUPERVISOR_USERNAME=EMP-2217
DEMO_SUPERVISOR_PASSWORD=replace-with-a-long-supervisor-password
