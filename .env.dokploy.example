# Values for the Dokploy Environment editor. Copy the values into the Dokploy
# UI; do not commit a filled copy. Passwords must be URL-safe because
# POSTGRES_PASSWORD is embedded in DATABASE_URL. Avoid @ : / ? # and $.

POSTGRES_USER=echallan
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=echallan_demo
API_ORIGIN=http://api:3001

# Admin dashboard sign-in. On first start the API creates a matching users row
# with no stored password, so this environment password is used at sign-in.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=replace-with-a-long-admin-password

# The API requires all three role accounts to be configured. These rows are
# bootstrapped too; Marshal sign-in additionally needs an authorised post.
DEMO_MARSHAL_USERNAME=marshal
DEMO_MARSHAL_PASSWORD=replace-with-a-long-marshal-password
DEMO_SUPERVISOR_USERNAME=supervisor
DEMO_SUPERVISOR_PASSWORD=replace-with-a-long-supervisor-password
