# Local development environment for the S-01 foundation. No production secrets.
# Copy to .env for local use: cp .env.example .env

# Development/demo database (schema + synthetic demo fixtures)
DATABASE_URL=postgresql://challan:challan@127.0.0.1:5432/echallan_demo

# Isolated test database. The name must end with _test; the integration runner
# refuses any database that is not explicitly a test target.
TEST_DATABASE_URL=postgresql://challan:challan@127.0.0.1:5433/echallan_test

# API process
PORT=3001
HOST=127.0.0.1
# Local evidence files (relative paths are resolved from the workspace root).
EVIDENCE_ROOT=./var/evidence
API_ORIGIN=http://127.0.0.1:3001

# Non-secret browser-visible API origin used by the Vite dev servers.
VITE_API_ORIGIN=http://127.0.0.1:3001

# Demo role accounts (F-02, addendum A v0.2). One username/password per approved
# role, held in the API server environment only. These placeholders are
# deliberately EMPTY: the API refuses to start when any value is missing or blank,
# and no working secret is ever committed. Set real values in your local .env, or
# in CI as secrets.
#
# Never give these a VITE_ prefix: that would ship them to the browser bundle.
# The usernames must be distinct, must match an existing seeded `users` row, and
# that row's stored role must equal the variable's role.
#
#   DEMO_MARSHAL_USERNAME=...      DEMO_MARSHAL_PASSWORD=...
#   DEMO_SUPERVISOR_USERNAME=...   DEMO_SUPERVISOR_PASSWORD=...
#   DEMO_ADMIN_USERNAME=...        DEMO_ADMIN_PASSWORD=...
#
DEMO_MARSHAL_USERNAME=
DEMO_MARSHAL_PASSWORD=
DEMO_SUPERVISOR_USERNAME=
DEMO_SUPERVISOR_PASSWORD=
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
#
# Automated browser acceptance does NOT use this file: Playwright passes the
# committed synthetic fixture tests/fixtures/f02-demo-credentials.json to the API
# process, so `pnpm run test:e2e` is reproducible from a clean checkout.

