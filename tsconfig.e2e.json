{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "apps/tablet/e2e/**/*.ts",
    "apps/admin/e2e/**/*.ts"
  ]
}
