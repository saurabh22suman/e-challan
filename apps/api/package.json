{
  "name": "@echallan/api",
  "version": "0.1.0",
  "private": true,
  "description": "Gate e-Challan Fastify API (foundation health/readiness and plumbing only)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:deploy": "node dist/deploy-start.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed:demo": "tsx src/db/seed-demo.ts",
    "db:seed:domain": "tsx src/db/seed-domain-demo.ts",
    "db:seed:env-users": "tsx src/db/seed-env-users.ts"
  },
  "dependencies": {
    "@echallan/contracts": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
