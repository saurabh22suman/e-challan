{
  "name": "echallan",
  "version": "0.1.0",
  "private": true,
  "description": "Gate e-Challan pilot workspace root (infrastructure foundation only)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "build:packages": "pnpm --filter @echallan/contracts --filter @echallan/theme run build",
    "dev": "pnpm run build:packages && pnpm -r --parallel run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm run check:boundaries",
    "lint:eslint": "eslint .",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:tablet-size": "node tools/check-tablet-size.mjs",
    "typecheck": "pnpm run build:packages && pnpm -r --workspace-concurrency=1 run typecheck && pnpm run typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "pnpm run build:packages && pnpm -r --workspace-concurrency=1 run test",
    "test:integration": "pnpm --filter @echallan/api run test:integration",
    "test:e2e": "pnpm run build:packages && playwright test",
    "test:foundation": "python3 -m unittest discover -s tests/foundation -p 'test_*.py' -v",
    "build": "pnpm run build:packages && pnpm -r run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down --remove-orphans",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "pnpm --filter @echallan/api run db:migrate",
    "db:seed:demo": "pnpm --filter @echallan/api run db:seed:demo",
    "db:seed:domain": "pnpm --filter @echallan/api run db:seed:domain"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
